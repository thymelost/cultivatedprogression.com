# Normalize all text to LF in the repo, regardless of editor/OS.
# Prevents CRLF churn from Windows tooling on a Unix-authored repo.
* text=auto eol=lf

# Explicit text types (belt and suspenders)
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf

# Binary assets — never touch line endings
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
